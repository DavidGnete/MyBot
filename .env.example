# Copia este archivo como .env y cambia los valores.
# .env NUNCA se sube al repositorio.

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info

# --- Base de datos (Postgres en docker-compose) ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=agente_empleo
POSTGRES_PORT=5432
DATABASE_URL=postgres://agente:cambia-esta-clave@localhost:5432/agente_empleo

# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:valor-ficticio
# Tu chat id: arranca el bot sin él, envíale /start y te lo dirá
TELEGRAM_CHAT_ID=

# --- Fuentes con key ---
# Gratis en https://co.jooble.org/api/about — la key SOLO sirve en el sitio del país donde la registres
JOOBLE_API_KEY=valor-ficticio
JOOBLE_SITIO=co.jooble.org

# --- Correo de alertas de empleo (Gmail, solo lectura) ---
# Correo DEDICADO a tu búsqueda (no el corporativo). Clave = "contraseña de aplicación"
# de Google (myaccount.google.com/apppasswords), NO tu contraseña normal.
CORREO_USUARIO=ejemplo.busqueda@gmail.com
CORREO_CLAVE_APP=abcd efgh ijkl mnop

# --- Postulación ---
# Máximo de postulaciones enviadas por día
LIMITE_DIARIO=10

# --- Navegador ---
# true = ver la ventana de Chrome mientras el bot llena formularios
NAVEGADOR_VISIBLE=false
