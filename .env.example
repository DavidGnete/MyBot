# Copia este archivo como .env y cambia los valores.
# .env NUNCA se sube al repositorio.

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info

# --- Base de datos (Postgres en docker-compose) ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=agente_empleo
POSTGRES_PORT=5432
DATABASE_URL=postgres://agente:cambia-esta-clave@localhost:5432/agente_empleo

# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=123456789:valor-ficticio
# Tu chat id: arranca el bot sin él, envíale /start y te lo dirá
TELEGRAM_CHAT_ID=
