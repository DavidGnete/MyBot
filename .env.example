# Copia este archivo como .env y cambia los valores.
# .env NUNCA se sube al repositorio.

# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=info

# --- Base de datos (Postgres en docker-compose) ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=agente_empleo
POSTGRES_PORT=5432
DATABASE_URL=postgres://agente:cambia-esta-clave@localhost:5432/agente_empleo
